# --- Cellcast ---
# Your Cellcast API key (Bearer token). Required.
CELLCAST_API_KEY=

# --- Airtable (event store + projections) ---
# Personal access token with data.records:read + data.records:write on the base. Required.
AIRTABLE_TOKEN=
# "Cellcast SMS" base id.
AIRTABLE_BASE_ID=apph4yvob8RzInWBO
# Table ids (already created; override only if you change them).
AIRTABLE_EVENTS_TABLE=tbljkVscc97CQdyCf
AIRTABLE_INBOUND_TABLE=tblx3T7VZr5bPK1wj
AIRTABLE_OUTBOUND_TABLE=tblIkEXrwXEyWUnEt
AIRTABLE_CONTACTS_TABLE=tbl4z0286KnRwksIf

# --- MCP endpoint protection (recommended) ---
# If set, callers must pass ?key=<MCP_SECRET> in the connector URL (or x-mcp-secret header).
# Also protects /api/rebuild.
MCP_SECRET=

# --- Webhook Basic Auth (optional) ---
# If set, configure the same username/password in the Cellcast dashboard webhook settings.
WEBHOOK_USER=
WEBHOOK_PASS=
